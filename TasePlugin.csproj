<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- We’ll include files via a glob from /src -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Optional: give the DLL a stable name -->
    <AssemblyName>TasePlugin</AssemblyName>
  </PropertyGroup>

  <!-- Compile all C# files under src\ recursively -->
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <!-- Reference CSS# API via env var or local lib (compile.ps1 stages a copy into /lib as a fallback) -->
  <ItemGroup>
    <Reference Include="CounterStrikeSharp.API">
      <HintPath>$(CSSHARP_DIR)\CounterStrikeSharp.API.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CounterStrikeSharp.API.Fallback" Condition=" '$(CSSHARP_DIR)' == '' ">
      <HintPath>lib\CounterStrikeSharp.API.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
