<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- We explicitly choose which .cs files to compile -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Optional: enable client command push path -->
    <!-- <DefineConstants>TASE_HAS_CLIENTCMD</DefineConstants> -->
  </PropertyGroup>

  <!-- Compile ONLY these files to keep the build green -->
  <ItemGroup>
    <Compile Include="TasePlugin.Main.cs" />
    <Compile Include="Tase.PhysGun.cs" />
    <Compile Include="TitleClass.cs" />
    <Compile Include="TitlesManager.cs" />
  </ItemGroup>

  <!-- Prefer env var path -->
  <ItemGroup Condition="Exists('$(CSSHARP_DIR)\CounterStrikeSharp.API.dll')">
    <Reference Include="CounterStrikeSharp.API">
      <HintPath>$(CSSHARP_DIR)\CounterStrikeSharp.API.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Try without the trailing \api as a fallback -->
  <ItemGroup Condition="Exists('$(CSSHARP_DIR)\addons\counterstrikesharp\api\CounterStrikeSharp.API.dll')">
    <Reference Include="CounterStrikeSharp.API">
      <HintPath>$(CSSHARP_DIR)\addons\counterstrikesharp\api\CounterStrikeSharp.API.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Local fallback: ./lib/CounterStrikeSharp.API.dll -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\lib\CounterStrikeSharp.API.dll')">
    <Reference Include="CounterStrikeSharp.API">
      <HintPath>$(MSBuildProjectDirectory)\lib\CounterStrikeSharp.API.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Newtonsoft for titles DB -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Helpful error if we can't find the API anywhere -->
  <Target Name="CheckCounterStrikeSharpRef" BeforeTargets="Build"
          Condition="!Exists('$(CSSHARP_DIR)\CounterStrikeSharp.API.dll') and !Exists('$(CSSHARP_DIR)\addons\counterstrikesharp\api\CounterStrikeSharp.API.dll') and !Exists('$(MSBuildProjectDirectory)\lib\CounterStrikeSharp.API.dll')">
    <Error Text="CounterStrikeSharp.API.dll not found. Set CSSHARP_DIR to your server folder or copy the DLL into ./lib/" />
  </Target>
</Project>
